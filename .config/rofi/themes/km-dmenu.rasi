/**
 * ROFI Dinamyc Color theme
 * Copyright: Molina Kevin 
 */

* {
    font:                   "SauceCodePro Nerd Form Mono 12";
    border:                 0px;
    padding:                0px;
    margin:                 0px;
    height:                 35px; 
	back: 					#23120f;
	fore: 					#c8c3c3;
	color0:					#23120f;
	color1:					#2E518D;
	color2:					#5F699F;
	color3:					#A87394;
	color4:					#7486BB;
	color5:					#A791A6;
	color6:					#DEA7A8;
	color7:					#c8c3c3;
	color8:					#74605e;
	color9:					#2E518D;
	color10:				#5F699F;
	color11:				#A87394;
	color12:				#7486BB;
	color13:				#A791A6;
	color14:				#DEA7A8;
	color15:				#c8c3c3;
    background-color:       @back;
    border-color:           @back;
    text-color:             @fore;
}

window {
    anchor:                 north;
    location:               north;
    width:                  100%;
    padding:                0px;
    children:               [ horibox ];
    border-color:           @color3;
    border:                 0px 0px 1px 0px;
}

horibox {
    orientation:            horizontal;
    children:               [ prompt, entry, listview ];
}

prompt {
	padding: 				6px 4px 0px 4px;
    text-color:             @color0;
    background-color:       @color3;
}

entry {
	padding: 				6px 0px 0px 4px;
    expand:                 false;
    width:                  10em;
    text-color:             @color3;
}

listview {
    layout:                 horizontal;
    spacing:                0px;
    lines:                  100;
    border:                 0px;
	padding: 				6px 0px 0px 0px;
}

element {
    padding:                0px 8px;
}

element normal.normal {
	text-color: 	        @color0;
	background-color:       @color6;
}

element alternate.normal {
    text-color: 		    @color6;
    background-color: 	    @color0;
}

element.selected.normal {
    text-color:             @color6;
    background-color:       @color2;
}

element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}
