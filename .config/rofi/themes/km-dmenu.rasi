/**
 * ROFI Dinamyc Color theme
 * Copyright: Molina Kevin 
 */

* {
    font:                   "SauceCodePro Nerd Form Mono 12";
    border:                 0px;
    padding:                0px;
    margin:                 0px;
    height:                 35px; 
	back: 					"#0e0e0e";
	fore: 					"#c5c4c3";
	color0:					"#0e0e0e";
	color1:					"#5EA06C";
	color2:					"#FDA62E";
	color3:					"#C7B963";
	color4:					"#596699";
	color5:					"#A46AA1";
	color6:					"#55A3AB";
	color7:					"#c5c4c3";
	color8:					"#898988";
	color9:					"#5EA06C";
	color10:				"#FDA62E";
	color11:				"#C7B963";
	color12:				"#596699";
	color13:				"#A46AA1";
	color14:				"#55A3AB";
	color15:				"#c5c4c3";
    background-color:       @back;
    border-color:           @back;
    text-color:             @fore;
}

window {
    anchor:                 north;
    location:               north;
    width:                  100%;
    padding:                0px;
    children:               [ horibox ];
    border-color:           @color3;
    border:                 0px 0px 1px 0px;
}

horibox {
    orientation:            horizontal;
    children:               [ prompt, entry, listview ];
}

prompt {
	padding: 				6px 4px 0px 4px;
    text-color:             @color0;
    background-color:       @color3;
}

entry {
	padding: 				6px 0px 0px 4px;
    expand:                 false;
    width:                  10em;
    text-color:             @color3;
}

listview {
    layout:                 horizontal;
    spacing:                0px;
    lines:                  100;
    border:                 0px;
	padding: 				6px 0px 0px 0px;
}

element {
    padding:                0px 8px;
}

element normal.normal {
	text-color: 	        @color0;
	background-color:       @color6;
}

element alternate.normal {
    text-color: 		    @color6;
    background-color: 	    @color0;
}

element.selected.normal {
    text-color:             @color6;
    background-color:       @color2;
}

element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}
